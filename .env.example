# extension usa a extensão local em chrome-extension/ (modo padrão seguro).
# cdp só deve ser habilitado deliberadamente com um perfil Chrome dedicado,
# iniciado pelo usuário para o GRID SOUL; nunca reutilize o perfil pessoal.
GRID_SOUL_CHATGPT_BRIDGE=extension

# Opcional; mantenha 8765 ao usar a extensão Chrome incluída.
GRID_SOUL_PORT=8765
